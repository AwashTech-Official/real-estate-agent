# GEMINI_API_KEY: Required for Gemini AI API calls and fallback voice/transcription generation.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADDIS ASSISTANT API CONFIGURATION (Server-Side Only)
# Optional: If configured, Sheger Prime prioritizes Addis Assistant speech & voice endpoints.
# If not configured, the assistant automatically and transparently uses Gemini 3.8 Flash TTS
# and Gemini 3.5 Transcribe with zero disruption to the user.
ADDIS_API_KEY=""
ADDIS_API_ENDPOINT=""
ADDIS_STT_ENDPOINT=""
ADDIS_TTS_ENDPOINT=""

# SUPABASE INTEGRATION (Server-Side Only for Sheger Prime Database)
# Connects to the existing Sheger Prime Real Estate Supabase database.
# Configure these in the AI Studio Secrets panel.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
